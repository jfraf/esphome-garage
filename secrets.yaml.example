# Vorlage: nach secrets.yaml kopieren und ausfüllen.
# secrets.yaml steht in .gitignore und gehört nicht ins Repository.

wifi_ssid: "MeinWLAN"
wifi_password: "WLAN-Passwort"

# Passwort für den Notfall-Zugangspunkt, mindestens 8 Zeichen
ap_password: "mindestens8zeichen"

# Passwort für Firmware-Updates über WLAN
ota_password: "ein-eigenes-passwort"

# 32 Byte, Base64. Erzeugen in der PowerShell:
#   py -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
api_key: "HIER-DEN-ERZEUGTEN-SCHLUESSEL-EINTRAGEN"
